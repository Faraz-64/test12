{
  "ollama": {
    "base_url": "http://localhost:11434",
    "model": "qwen3.5:2b",
    "embedding_model": "nomic-embed-text",
    "embedding_query_prefix": "search_query: ",
    "embedding_document_prefix": "search_document: ",
    "timeout_seconds": 300,
    "num_ctx": 6144,
    "keep_alive": "30m",
    "think": false
  },
  "model_params": {
    "temperature_chat": 0.6,
    "temperature_code": 0.2,
    "temperature_grounded": 0.1,
    "temperature_json": 0.0,
    "max_output_tokens": 0
  },
  "memory": {
    "file": "memory.json",
    "fact_budget_tokens": 400,
    "history_budget_tokens": 1200,
    "recall_budget_tokens": 500,
    "max_history_messages": 1000,
    "auto_save_facts": "auto"
  },
  "semantic": {
    "enabled": true,
    "min_similarity": 0.55,
    "top_k": 5,
    "max_indexed_messages": 300
  },
  "reminders": {
    "file": "reminders.json",
    "poll_seconds": 1.0,
    "beep": true
  },
  "browser": {
    "preferred": "default",
    "fallback_to_default": true
  },
  "voice": {
    "enabled": true,
    "speak_replies": true,
    "vosk_model_path": "models/vosk-model-small-en-in-0.4",
    "listen_seconds": 8,
    "tts_rate": 175
  },
  "documents": {
    "max_file_mb": 25,
    "max_pages": 300,
    "chunk_chars": 900,
    "chunk_overlap": 120,
    "top_k": 4,
    "ocr": true,
    "tesseract_cmd": "",
    "allowed_extensions": [
      ".txt",
      ".md",
      ".pdf",
      ".docx"
    ]
  },
  "tools": {
    "model_routing": "auto",
    "max_tool_calls": 1,
    "chain": false,
    "timeout_seconds": 60
  },
  "pc": {
    "screenshot_dir": "screenshots",
    "volume_step": 10
  },
  "gui": {
    "theme": "dark",
    "font_size": 11
  },
  "logging": {
    "level": "INFO",
    "file": "jarvis.log"
  }
}